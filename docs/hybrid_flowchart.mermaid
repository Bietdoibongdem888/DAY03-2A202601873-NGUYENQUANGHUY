flowchart TD
    U["User Input"] --> V{"Input Guardrail<br/>hợp lệ, không PII/injection?"}
    V -- "Không" --> E["Guardrail Response<br/>không gọi LLM/Tool"]
    V -- "Có" --> I["Intent Classification"]
    I --> M{"Thiếu thông tin thiết yếu?"}
    M -- "Có" --> CL["Clarification Path<br/>hỏi tối đa câu cần thiết · 0 tool"]
    M -- "Không" --> AF["Agentic Fit 6 tiêu chí<br/>0-2 điểm mỗi tiêu chí"]
    AF --> D{"Tổng điểm / nhu cầu tool"}

    D -- "0-4 hoặc không cần tool" --> C["Chatbot Path<br/>1 LLM call · 0 tool"]
    C --> CF["Tư vấn tham khảo<br/>không cam kết tuyệt đối"]

    D -- "5-8: Hybrid cân nhắc" --> H{"Có dữ liệu ngoài/cập nhật?"}
    H -- "Không" --> C
    H -- "Có" --> A
    D -- "9-12: ReAct" --> A["OreoAI ReAct Agent"]
    A --> T["Reason nội bộ: chọn đúng một bước"]
    T --> X["Action: tool[arg]"]
    X --> G{"Allowlist + schema + input hợp lệ?"}
    G -- "Không" --> O1["Observation: error_code<br/>không thực thi"]
    G -- "Có" --> R["Executor: timeout + retry ≤ 1"]
    R --> Z{"Output rỗng/sai schema/injection?"}
    Z -- "Có" --> O1
    Z -- "Không" --> O2["Observation do ứng dụng chèn<br/>source=mock"]
    O1 --> B{"Còn budget và có Action mới?"}
    O2 --> Q{"Đã đủ bằng chứng?"}
    Q -- "Chưa" --> B
    B -- "Có" --> T
    B -- "Không / lặp Action" --> S["Safe fallback · MAX_ITERATIONS"]
    Q -- "Đủ" --> F["Final Answer có căn cứ<br/>nêu phạm vi và yêu cầu kiểm chứng"]
    CF --> L["Structured Trace Log<br/>không chứa Thought/secret/PII"]
    CL --> L
    E --> L
    F --> L
    S --> L
