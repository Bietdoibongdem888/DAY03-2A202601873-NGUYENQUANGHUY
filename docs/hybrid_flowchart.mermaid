graph TD
    START[("User Question")] --> DETECT{"Detect Query Type"}
    
    DETECT -->|"Simple / General Advice"| CHATBOT_PATH["🟢 CHATBOT PATH (Level 2)"]
    DETECT -->|"Needs Real Data / Multi-step"| AGENT_PATH["🟡 REACT AGENT PATH (Level 3)"]
    
    CHATBOT_PATH --> LLM1["LLM generates answer<br/>from static knowledge"]
    LLM1 --> CHAT_OUT[("Answer to User")]
    
    AGENT_PATH --> LOOP_START["🔄 ReAct Loop Start<br/>step = 1"]
    LOOP_START --> THINK["🧠 Thought:<br/>What do I need to know?"]
    THINK --> ACT{"🛠️ Action:<br/>Which tool to call?"}
    
    ACT -->|"Market info"| T1["get_job_market[field]"]
    ACT -->|"Skills gap"| T2["check_skills[skills, job]"]
    ACT -->|"Courses"| T3["search_courses[field]"]
    ACT -->|"Career path"| T4["get_career_path[role]"]
    ACT -->|"No tool needed"| FINAL
    
    T1 --> OBS["👁️ Observation:<br/>Tool returns data"]
    T2 --> OBS
    T3 --> OBS
    T4 --> OBS
    
    OBS --> CHECK{"Has enough info?"}
    CHECK -->|"No, need more"| INC["step += 1"]
    INC --> GUARD{"step > MAX_ITERATIONS?"}
    GUARD -->|"Yes"| GUARD_OUT["🛡️ Guardrail:<br/>Stop & notify user"]
    GUARD -->|"No"| THINK
    
    CHECK -->|"Yes"| FINAL["🏁 Final Answer:<br/>Complete response to user"]
    FINAL --> AGENT_OUT[("Answer to User")]
    
    GUARD_OUT --> AGENT_OUT
    
    style CHATBOT_PATH fill:#E3F2FD,stroke:#1565C0
    style AGENT_PATH fill:#FFF3E0,stroke:#E65100
    style GUARD fill:#FFCDD2,stroke:#C62828
    style FINAL fill:#C8E6C9,stroke:#2E7D32
    style START fill:#F3E5F5,stroke:#6A1B9A
